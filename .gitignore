# 忽略文件说明：https://help.github.com/articles/ignoring-files/

# 依赖目录
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试产物
/coverage

# Next.js 构建产物
/.next/
/out/

# 生产环境产物
/build

# 其他系统文件
.DS_Store
*.pem

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量文件（如确需提交，请显式取消忽略）
.env*

# Vercel 配置
.vercel

# TypeScript 生成文件
*.tsbuildinfo
next-env.d.ts
